<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Support | EventPlatform</title>
    <link rel="stylesheet" href="/CSS/main.css">
    <link rel="stylesheet" href="/CSS/contact.css"> </head>
<body>
    <%- include('partials/navbar') %>

    <main class="contact-container">
        <section class="contact-header">
            <h1>Get in Touch</h1>
            <p>Have a question about an event? Kevin and the team are ready to help.</p>
        </section>

        <div class="contact-card shadow">
            <% if (typeof success !== 'undefined' && success) { %> 
                <div class="alert alert-success animate-in"><%= success %></div> 
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %> 
                <div class="alert alert-danger animate-in"><%= error %></div> 
            <% } %>

            <form action="/contact" method="POST" class="contact-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name</label>
                        <input type="text" id="name" name="name" class="form-input" 
                               placeholder="e.g. Tobie Jansen" required 
                               value="<%= user ? user.name : '' %>">
                    </div>
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-input" 
                               placeholder="your@email.com" required 
                               value="<%= user ? user.email : '' %>">
                    </div>
                </div>

                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" class="form-input" 
                           placeholder="What is this regarding?" required>
                </div>

                <div class="form-group">
                    <label for="message">Your Message</label>
                    <textarea id="message" name="message" class="form-textarea" 
                              rows="5" placeholder="How can we help you today?" required></textarea>
                </div>

                <button type="submit" class="btn btn-submit">
                    <span class="btn-text">Send Enquiry</span>
                    <span class="btn-icon">→</span>
                </button>
            </form>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>