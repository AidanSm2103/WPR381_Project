<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events | EventPlatform</title>
    <link rel="stylesheet" href="/CSS/main.css">
    <link rel="stylesheet" href="/CSS/events.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <section class="hero">
        <div class="container">
            <h1>Discover Upcoming Events</h1>
            <p>Book your tickets for the best experiences.</p>
        </div>
    </section>

    <main class="container">
        <div class="event-grid">
            <% if (typeof events !== 'undefined' && events.length > 0) { %>
                <% events.forEach(event => { %>
                    <div class="event-card">
                        <div class="card-image">
                            <img src="<%= event.ImageURL || 'https://via.placeholder.com/600x400?text=Event+Image' %>" alt="<%= event.Title %>">
                            <div class="price-tag">R<%= event.Price %></div>
                        </div>
                        <div class="card-content">
                            <div class="category"><%= event.Category || 'General' %></div>
                            <h3><%= event.Title %></h3>
                            <p class="venue">📍 <%= event.Venue %></p>
                            <p class="date">📅 <%= new Date(event.Date).toLocaleDateString() %></p>
                            <div class="card-footer">
                                <a href="/event-details/<%= event._id %>" class="btn btn-outline">View Details</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="text-align: center; width: 100%; color: #64748b;">No events are currently scheduled. Check back soon!</p>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>