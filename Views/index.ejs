<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/events.css">
</head>
<body>

    <%- include('partials/navbar') %>

    <section class="hero">
        <h1>Find Amazing Events</h1>
        <p>Book conferences, workshops, festivals and more.</p>
    </section>

    <section class="search-section">
        <input type="text" placeholder="Search events...">

        <select>
            <option>All Categories</option>
            <option>Conference</option>
            <option>Festival</option>
            <option>Workshop</option>
        </select>

        <button>Search</button>
    </section>

    <section class="event-container">

        <div class="event-card">
            <img src="/images/Tech_Conference.jpg" alt="event">
            <h3>Tech Conference</h3>
            <p>Date: 15 June 2026</p>
            <p>Location: Johannesburg</p>
            <a href="/event/1" class="btn">View Event</a>
        </div>

        <div class="event-card">
            <img src="/images/Music_Fest.jpeg" alt="event">
            <h3>Music Festival</h3>
            <p>Date: 20 July 2026</p>
            <p>Location: Cape Town</p>
            <a href="/event/2" class="btn">View Event</a>
        </div>
    </section>

    <%- include('partials/footer') %>

</body>
</html>