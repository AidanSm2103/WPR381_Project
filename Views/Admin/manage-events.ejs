<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Events | Admin Panel</title>
    <link rel="stylesheet" href="/CSS/main.css">
    <link rel="stylesheet" href="/CSS/dashboard.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 40px; margin-bottom: 20px;">
            <h1>Manage Events</h1>
            <a href="/admin/create-event" class="btn btn-primary">+ New Event</a>
        </div>

        <div class="dashboard-card" style="padding: 0; overflow-x: auto;">
            <% if (typeof events !== 'undefined' && events.length > 0) { %>
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: #f1f5f9; border-bottom: 2px solid #e2e8f0;">
                            <th style="padding: 15px;">Title</th>
                            <th style="padding: 15px;">Date</th>
                            <th style="padding: 15px;">Capacity</th>
                            <th style="padding: 15px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% events.forEach(event => { %>
                            <tr style="border-bottom: 1px solid #e2e8f0;">
                                <td style="padding: 15px;"><strong><%= event.Title %></strong></td>
                                <td style="padding: 15px;"><%= new Date(event.Date).toLocaleDateString() %></td>
                                <td style="padding: 15px;"><%= event.SoldTickets || 0 %> / <%= event.Capacity %></td>
                                <td style="padding: 15px; display: flex; gap: 10px;">
                                    <a href="/admin/edit-event/<%= event._id %>" class="btn btn-outline" style="padding: 5px 10px; font-size: 0.85rem;">Edit</a>
                                    <form action="/admin/delete-event/<%= event._id %>" method="POST" style="margin: 0;">
                                        <button type="submit" class="btn btn-outline" style="color: #b91c1c; border-color: #b91c1c; padding: 5px 10px; font-size: 0.85rem;" onclick="return confirm('Delete this event permanently?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="padding: 30px; text-align: center; color: #64748b;">No events found in the database.</p>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>