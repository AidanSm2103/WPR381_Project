<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Event | Admin Portal</title>
    <link rel="stylesheet" href="/CSS/main.css">
    <link rel="stylesheet" href="/CSS/admin.css">
</head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <main class="container admin-container">
        <div class="admin-form-wrapper">
            <header class="admin-header">
                <div class="header-content">
                    <h1>Edit Event</h1>
                    <p>Modifying details for: <strong><%= event.Title %></strong></p>
                </div>
                <div class="header-badge">Editing Mode</div>
            </header>

            <div class="admin-card shadow-lg animate-in">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <form action="/admin/edit-event/<%= event._id %>" method="POST" class="modern-form">
                    
                    <section class="form-section">
                        <h3 class="section-title">Event Identity</h3>
                        <div class="form-group">
                            <label for="Title">Event Title</label>
                            <input type="text" id="Title" name="Title" class="form-input" 
                                   value="<%= event.Title %>" required>
                        </div>
                    </section>

                    <section class="form-section">
                        <h3 class="section-title">Schedule & Classification</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="Date">Date & Time</label>
                                <input type="datetime-local" id="Date" name="Date" class="form-input" 
                                       value="<%= new Date(event.Date).toISOString().slice(0, 16) %>" required>
                            </div>
                            <div class="form-group">
                                <label for="Category">Category</label>
                                <select id="Category" name="Category" class="form-input" required>
                                    <option value="Motorsport" <%= event.Category === 'Motorsport' ? 'selected' : '' %>>Motorsport</option>
                                    <option value="Photography" <%= event.Category === 'Photography' ? 'selected' : '' %>>Photography</option>
                                    <option value="Gaming" <%= event.Category === 'Gaming' ? 'selected' : '' %>>Gaming</option>
                                    <option value="Technology" <%= event.Category === 'Technology' ? 'selected' : '' %>>Technology</option>
                                    <option value="Music" <%= event.Category === 'Music' ? 'selected' : '' %>>Music</option>
                                </select>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <h3 class="section-title">Capacity & Pricing</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="Price">Ticket Price (R)</label>
                                <div class="input-with-icon">
                                    <span class="icon">R</span>
                                    <input type="number" id="Price" name="Price" class="form-input" 
                                           min="0" value="<%= event.Price %>" required>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="Capacity">Total Capacity</label>
                                <input type="number" id="Capacity" name="Capacity" class="form-input" 
                                       min="1" value="<%= event.Capacity %>" required>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <h3 class="section-title">Location & Media</h3>
                        <div class="form-group">
                            <label for="Venue">Venue / Location</label>
                            <input type="text" id="Venue" name="Venue" class="form-input" 
                                   value="<%= event.Venue %>" required>
                        </div>

                        <div class="form-group">
                            <label for="ImageURL">Cover Image URL</label>
                            <input type="url" id="ImageURL" name="ImageURL" class="form-input" 
                                   value="<%= event.ImageURL %>" required>
                        </div>

                        <div class="form-group">
                            <label for="Description">Event Description</label>
                            <textarea id="Description" name="Description" class="form-textarea" 
                                      rows="5" required><%= event.Description %></textarea>
                        </div>
                    </section>

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary btn-publish">
                            Save Changes 💾
                        </button>
                        <a href="/admin/manage-events" class="btn btn-outline btn-cancel text-center">Discard Changes</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>