<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics | Admin Portal</title>
    <link rel="stylesheet" href="/CSS/main.css">
    <link rel="stylesheet" href="/CSS/admin.css"> </head>
<body class="bg-light">
    <%- include('../partials/navbar') %>

    <main class="container admin-container">
        <header class="admin-header">
            <div class="header-content">
                <h1>Platform Analytics</h1>
                <p>Live business insights and event performance metrics.</p>
            </div>
            <div class="header-badge">Live Dashboard</div>
        </header>

        <div class="form-row" style="margin-bottom: 40px;">
            <div class="admin-card p-4 text-center">
                <span class="section-title">Total Revenue</span>
                <div class="number-display" style="font-size: 2.5rem; font-weight: 800; color: #166534; margin-top: 10px;">
                    R<%= totalRevenue.toLocaleString() %>
                </div>
            </div>
            
            <div class="admin-card p-4 text-center">
                <span class="section-title">Tickets Sold</span>
                <div class="number-display" style="font-size: 2.5rem; font-weight: 800; color: #2563eb; margin-top: 10px;">
                    <%= ticketsSold %>
                </div>
            </div>

            <div class="admin-card p-4 text-center">
                <span class="section-title">Active Events</span>
                <div class="number-display" style="font-size: 2.5rem; font-weight: 800; color: #1e293b; margin-top: 10px;">
                    <%= activeEvents %>
                </div>
            </div>
        </div>

        <section class="form-section">
            <h3 class="section-title">Event Performance Breakdown</h3>
            <div class="table-card shadow-sm">
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Event Details</th>
                                <th>Category</th>
                                <th>Capacity</th>
                                <th>Sold</th>
                                <th>Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof events !== 'undefined' && events.length > 0) { %>
                                <% events.forEach(event => { %>
                                    <tr>
                                        <td class="user-cell">
                                            <strong><%= event.Title %></strong>
                                            <small><%= event.Venue %></small>
                                        </td>
                                        <td>
                                            <span class="status-badge pending">
                                                <%= event.Category %>
                                            </span>
                                        </td>
                                        <td><%= event.Capacity %></td>
                                        <td>
                                            <span style="font-weight: 600;">
                                                <%= event.SoldTickets || 0 %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong>R<%= ((event.SoldTickets || 0) * event.Price).toLocaleString() %></strong>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center" style="padding: 40px; color: #94a3b8;">
                                        No performance data available.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>